APP_ENV=lab
SERVICE_NAME=lab-api
API_PREFIX=/api/v1
WEB_PORT=3100
API_PORT=8100
DB_HOST=lab-db
DB_PORT=5432
DB_NAME=mvp_lab
DB_USER=lab_user
DB_PASSWORD=lab_password
DB_CONNECT_TIMEOUT_SECONDS=3
CORS_ALLOW_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,http://localhost:5173,http://127.0.0.1:5173
API_BASE_URL=http://localhost:8100
VITE_API_BASE_URL=http://localhost:8100
FILE_STORAGE_ROOT=/app/storage
LOG_DIR=/app/logs
CASE_DOC_MASTER_SOURCE=export_file
CASE_DOC_ACCESS_EXPORT_DIR=/app/storage/access_exports
CASE_DOC_IMPORT_STRICT=true
CASE_DOC_PLACEHOLDER_MAPPING_PATH=/app/storage/config/placeholder_mapping.yml
MODULE_IMAGE_STORAGE_DIR=/app/storage/module_images
